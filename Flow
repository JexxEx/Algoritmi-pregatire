#include <bits/stdc++.h>
using namespace std;
const int NMAX = 5005;
struct edge {
    int cap, to;
    edge() {
        cap = to = 0;
    }
    edge(int cap, int to) {
        this->cap = cap; this->to = to;
    }
};
int n, s, t;
//s-> sursa
//t->scurgere
vector<edge> edges;
vector<int> g[NMAX];
void add_edge(int a, int b, int c) {
    g[a].push_back(edges.size());
    edges.push_back(edge(c, b));
    g[b].push_back(edges.size());
    edges.push_back(edge(0, a));
}
int max_flow() {
    int flow = 0;
    while (true) {
        vector<int> pe(n + 1, -1);
        pe[s] = -2;
        queue<int> q;
        q.push(s);
        while (!q.empty()) {
            int u = q.front();
            q.pop();
            for (auto w : g[u]) {
                auto v = edges[w];
                if (pe[v.to] == -1 and v.cap > 0) {
                    q.push(v.to);
                    pe[v.to] = w;
                }
            }
        }
        if (pe[t] == -1)break;
        int min_flow = INT_MAX;
        for (int curr = t; curr != s; curr = edges[pe[curr] ^ 1].to) {
            min_flow = min(min_flow, edges[pe[curr]].cap);
        }
        for (int curr = t; curr != s; curr = edges[pe[curr] ^ 1].to) {
            edges[pe[curr]].cap -= min_flow;
            edges[pe[curr]^ 1].cap += min_flow;
        }
        flow += min_flow;
    }
    return flow;
}
