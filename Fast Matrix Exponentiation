#include <bits/stdc++.h>
using namespace std;
const int mod = 1e9 + 7;
typedef vector<vector<long long>> matrix;
matrix mult(const matrix &a, const matrix &b) {
    int k = a.size();
    matrix c(k, vector<long long>(k));
    for (int i = 0; i < k; i++) {
        for (int j = 0; j < k; j++) {
            for (int t = 0; t < k; t++) {
                c[i][j] = (c[i][j] + a[i][t] * b[t][j]) % mod;
            }
        }
    }
    return c;
}
matrix fast_exp(matrix a, long long pow) {
    int k = a.size();
    matrix c(k, vector<long long>(k));
    for (int i = 0; i < k; i++) {
        c[i][i] = 1;
    }
    matrix base = c;
    while (pow) {
        if (pow & 1) c = mult(c, a);
        a = mult(a, a);
        pow >>= 1;
    }
    return c;
}
int main() {
    int n;
    cin >> n;
    matrix right = {{1, 0}, {1, 0}};
    matrix left = {{1, 1}, {1, 0}};
    right = mult(fast_exp(left, n), right);
    cout << (right[1][0]) % mod << '\n';
}
