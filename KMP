#include <bits/stdc++.h>
using namespace std;
vector<int> lps(const string &s) {
    int n = (int) s.size();
    vector<int> v(n);
    for (int i = 1, j = 0; i < n; i++) {
        while (j > 0 && s[j] != s[i]) j = v[j - 1];
        if (s[j] == s[i]) j++;
        v[i] = j;
    }
    return v;
}
vector<int> matches(const string &a, const string &b) {
    //Checks all substrings of a which are identical to b
    int n = (int) a.size();
    int m = (int) b.size();
    vector<int> p = lps(b);
    vector<int> app;
    for (int i = 0, j = 0; i < n; i++) {
        while (j > 0 && a[i] != b[j]) j = p[j - 1];
        if (a[i] == b[j]) j++;
        if (j == m) {
            app.push_back(i - m  + 1);
            j = p[j - 1];
        }
    }
    return app;
}
int main() {
    string a, b;
    cin >> a >> b;
    for (auto x : matches(a, b)) {
        cout << x << ' ';
    }
}
