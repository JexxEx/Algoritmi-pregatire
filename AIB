//cuprinde si cautare binara prin binary lifting in log(n). 
#include <bits/stdc++.h>
#include <cassert>
#define pb push_back
using namespace std;
struct bit{
  //cu siguranta corect
  int n, pow2;
  vector<long long> v;
  bit(){

  }
  bit(int n){
      this-> n = n;
      v.assign(n + 1, 0LL);
      pow2 = 1;
      while(pow2 < n) pow2 *= 2;
  }
  void update(int val, int pos){
      assert(1 <= pos and pos <= n);
      for(int i = pos; i <= n; i += (i & -i)){
          v[i] += val;
      }
  }
  long long q(int pos){
      if(pos < 1) return 0;
      long long ans = 0;
      for(int i = pos; i >= 1; i -= (i & -i)){
          ans += v[i];
      }
      return ans;
  }
  long long query(int l, int r){
      assert(1 <= l and l <= r and r <= n);
      l--;
      return q(r) - q(l);
  }
  //cel mai din dreapta indice p pentru care v[1] + v[2] + ... + v[p] <= k
  int lower_search(int val){
      int pos = 0;
      for(int step = pow2; step > 0; step >>= 1){
          if(pos + step <= n and v[pos + step] <= val){
              val -= v[pos + step];
              pos += step;
          }
      }
      return pos;
  }
  //cel mai din stanga indice p pentru care v[1] + v[2] + ... + v[p] >= k
  int upper_search(int val){
      //Daca nu exista returneaza n + 1
      int pos = 0;
      for(int step = pow2; step > 0; step >>=1){
          if(pos + step <= n and v[pos + step] < val){
              val -= v[pos + step];
              pos += step;
          }
      }
      return pos + 1;
  }
};
