//DSU with path compression 
#include <bits/stdc++.h>
using namespace std;
struct dsu {
    int n;
    vector<int> p, sz;
    dsu(int n) {
        this->n = n;
        p.assign(n + 1, 0);
        sz.assign(n + 1, 1);
        iota(p.begin(), p.end(), 0);
    }
    int find(int x) {
        return p[x] == x ? x : p[x] = find(p[x]);
    }
    void unite(int x, int y) {
        if (x == y) return;
        x = find(x);
        y = find(y);
        if (sz[x] < sz[y]) swap(x, y);
        p[y] = x;
        sz[x] += sz[y];
    }
};
