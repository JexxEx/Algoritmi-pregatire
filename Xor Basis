#include <bits/stdc++.h>
using namespace std;

//Pretty much black box, daca pica asa ceva in concurs, oricum e simpla implementarea.
struct xor_basis {
    const static int BIT = 60;
    long long b[BIT] = {};
    int n = 0;

    bool insert(long long x) {
        n++;
        for (int i = 59; i >= 0; --i) {
            if (!(x >> i & 1))continue;
            if (!b[i]) {
                b[i] = x;
                return true;
            } else x ^= b[i];
        }
        return false;
    }

    bool in_set(long long x) {
        for (int i = 59; i >= 0; --i) {
            if (!(x >> i & 1))continue;
            x ^= b[i];
        }
        return x == 0;
    }

    int rank() {
        int r = 0;
        for (int i = 59; i >= 0; --i) {
            if (b[i])r++;
        }
        return r;
    }

    long long subsets() {
        return (1LL << rank());
    }

    long long max_value_in_subset() {
        long long ans = 0;
        for (int i = 59; i >= 0; --i) {
            ans = max(ans, ans ^ b[i]);
        }
        return ans;
    }

    long long subsets_that_form(long long x) {
        if (in_set(x)) {
            return 1LL << (n - rank());
        } else return 0LL;
    }
};
